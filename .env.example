# Kopiere diese Datei nach ".env.local" und trage deine Werte ein.
# .env.local wird NICHT ins Repo committed (siehe .gitignore).
#
# Erlaubt sind hier NUR die öffentliche Projekt-URL und der "anon" (public) Key.
# NIEMALS den "service_role"-Key eintragen!
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-public-key

# Nur für GitHub Pages nötig (Pfad des Repos). Lokal leer lassen.
# Wird im GitHub-Actions-Workflow automatisch auf "/<repo-name>/" gesetzt.
# VITE_BASE=/habit-tracker/
